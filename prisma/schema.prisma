generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Repo {
  id        String   @id @default(cuid())
  userId    String
  githubId  Int      @unique
  name      String
  fullName  String
  private   Boolean  @default(false)
  webhookId Int?
  hasCI     Boolean  @default(false)   
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    GithubEvent[]
  issueJobs GithubIssueJob[]
  triages   IssueTriage[]
  prOutcomes PrOutcome[]
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  repos         Repo[]
  githubEvents  GithubEvent[]
  issueJobs     GithubIssueJob[]
  triages       IssueTriage[]
  prOutcomes    PrOutcome[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model GithubEvent {
  id          String      @id @default(cuid())
  userId      String
  repoId      String
  type        EventType
  title       String
  description String?
  sourceBranch String?
  payload     Json
  status      EventStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  resolveJob ResolveJob? 
}

enum EventType {
  PR_CONFLICT
  CI_FAILURE
  MERGE_ERROR
  CODE_ERROR
  PR_REVIEW_REQUESTED
}

enum EventStatus {
  PENDING
  RESOLVING
  RESOLVED
  FAILED
  IGNORED
}

model ResolveJob {
  id          String    @id @default(cuid())
  eventId     String    @unique
  status      JobStatus @default(QUEUED)
  prUrl       String?
  prNumber    Int?
  errorMsg    String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event GithubEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum JobStatus {
  QUEUED
  FETCHING_CONTEXT
  ANALYZING
  PATCHING
  CREATING_PR
  COMPLETED
  FAILED
  CANCELLED
}

// Tracks the AI resolve job for a GitHub Issue.
// The issue itself lives on GitHub — we only store the job state and output (PR url, status, etc).
model GithubIssueJob {
  id          String          @id @default(cuid())
  userId      String
  repoId      String

  // GitHub issue fields — stored so we can display
  // them without re-fetching from GitHub API
  issueNumber Int
  issueTitle  String
  issueBody   String?         // original issue description
  issueUrl    String?         // link back to the GitHub issue

  // Branch strategy chosen in the resolve modal
  strategy     String          @default("new")  // "same" | "new" | "custom"
  branchName   String?         // final branch name used

  // Job lifecycle
  status      IssueJobStatus  @default(QUEUED)
  prUrl       String?
  prNumber    Int?
  errorMsg    String?

  // Self-critique step output — stored for debugging
  verifyVerdict  String?       // "approved" | "revised"
  verifyNote     String?       // reviewer's explanation

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  prOutcome PrOutcome?

  // One active job per issue per repo at a time
  // Prevents duplicate resolve jobs for the same issue
  @@unique([repoId, issueNumber])
}

enum IssueJobStatus {
  QUEUED           // job created, waiting for Inngest to pick it up
  FETCHING_CONTEXT // fetching issue body, comments, repo files
  ANALYZING        // Claude Pass 1 — generating the fix
  VERIFYING        // Claude Pass 2 — self-critique of the fix
  CREATING_PR      // committing files and opening the PR
  COMPLETED        // PR created successfully
  FAILED           // something went wrong — check errorMsg
  CANCELLED        // user cancelled before completion
}

// AI triage score for how safely GitHubResolver can resolve an issue.
// Invalidated when GitHub issue.updated_at is newer than issueUpdatedAt.
model IssueTriage {
  id             String       @id @default(cuid())
  userId         String
  repoId         String
  issueNumber    Int
  issueUpdatedAt DateTime
  confidence     Int
  effort         TriageEffort
  risk           TriageRisk
  reason         String
  model          String
  promptVersion  String
  provider       String       @default("anthropic")
  errorMsg       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, issueNumber])
  @@index([repoId])
  @@index([repoId, confidence])
}

enum TriageEffort {
  S
  M
  L
}

enum TriageRisk {
  low
  medium
  high
}

// Current lifecycle outcome for an AI-generated pull request.
// Linked 1:1 to GithubIssueJob; identity is (repoId, prNumber).
model PrOutcome {
  id                 String         @id @default(cuid())
  userId             String
  repoId             String
  jobId              String         @unique
  issueNumber        Int
  prNumber           Int
  prUrl              String
  state              PrOutcomeState @default(OPEN)
  openedAt           DateTime?
  mergedAt           DateTime?
  closedAt           DateTime?
  changesRequestedAt DateTime?
  lastObservedAt     DateTime       @default(now())
  githubUpdatedAt    DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repo           @relation(fields: [repoId], references: [id], onDelete: Cascade)
  job  GithubIssueJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([repoId, prNumber])
  @@index([repoId])
  @@index([state])
}

enum PrOutcomeState {
  OPEN
  MERGED
  CLOSED_UNMERGED
  CHANGES_REQUESTED
}

// Idempotency for GitHub webhook deliveries (x-github-delivery).
model WebhookDelivery {
  id          String   @id @default(cuid())
  deliveryId  String   @unique
  event       String
  action      String?
  repoId      String?
  processedAt DateTime @default(now())
}